1c:["$","section",null,{"className":"cyber-glass p-6 mb-6","children":[["$","h2",null,{"className":"font-cyber text-base text-cyber-red uppercase tracking-wider mb-3","children":"⚠ The Challenge"}],["$","p",null,{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed","children":"Most AI systems are tested for what they should do — almost none are systematically tested for what they should never do. Teams ship LLM features without knowing how they respond to prompt injection, jailbreaks, role-play exploits, or data-extraction attempts, and discover the failures in production."}]]}]
1d:["$","section",null,{"className":"cyber-glass p-6 mb-6","children":[["$","h2",null,{"className":"font-cyber text-base text-cyber-blue uppercase tracking-wider mb-3","children":"⚙ The Approach"}],["$","p",null,{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed","children":"I designed Sentinel AI as a structured red-teaming pipeline in Python: a library of attack strategies (prompt injection, jailbreak patterns, obfuscation, multi-turn manipulation), automated execution against target models, and scoring of responses for safety violations and alignment drift. The framework treats safety evaluation like software testing — repeatable suites instead of one-off manual poking."}]]}]
1e:["$","section",null,{"className":"cyber-glass p-6 mb-8","children":[["$","h2",null,{"className":"font-cyber text-base text-cyber-green uppercase tracking-wider mb-3","children":"✓ The Outcome"}],["$","p",null,{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed","children":"A reusable framework that surfaces concrete, reproducible failure cases in LLM systems before launch. The techniques behind it now inform every LLM feature I build for clients — guardrails, output validation, and adversarial pre-launch testing come standard."}]]}]
