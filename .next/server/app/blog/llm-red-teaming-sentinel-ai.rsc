22:["$","div","pre-0,code-0",{"className":"my-4 cyber-glass p-4 rounded-lg overflow-x-auto","children":["$","code",null,{"className":"font-code text-xs text-cyber-green whitespace-pre","children":"class AdversarialGenerator:\n    def generate(self, target_behavior: str, attack_type: AttackType) -> List[str]:\n        prompts = []\n        for template in self.templates[attack_type]:\n            prompts.append(template.format(behavior=target_behavior))\n        return prompts\n"}]}]
