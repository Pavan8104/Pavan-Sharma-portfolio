29:["$","ul","ul-1",{"className":"space-y-1 mb-4 ml-4","children":["\n",["$","li","li-0",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Role-playing attacks have an average 34% success rate against models without explicit persona-guard tuning"}]]}],"\n",["$","li","li-1",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Indirect injection through \"user-provided documents\" succeeds significantly more often than direct requests"}]]}],"\n",["$","li","li-2",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Models fine-tuned for helpfulness tend to be more vulnerable than base models — the alignment that makes them useful also makes them easier to manipulate"}]]}],"\n"]}]
