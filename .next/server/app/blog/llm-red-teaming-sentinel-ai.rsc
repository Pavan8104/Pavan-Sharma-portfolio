{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"LLM Red Teaming: How I Built Sentinel AI to Break Large Language Models\",\"description\":\"Most AI systems are tested for what they should do. I built a framework to test what they should never do — and the results were eye-opening.\",\"url\":\"https://pavansharmaportfolio.in/blog/llm-red-teaming-sentinel-ai/\",\"mainEntityOfPage\":\"https://pavansharmaportfolio.in/blog/llm-red-teaming-sentinel-ai/\",\"datePublished\":\"2026-05-14\",\"dateModified\":\"2026-05-14\",\"keywords\":\"LLM, AI Safety, Python, Red Teaming\",\"image\":\"https://pavansharmaportfolio.in/og-image.jpg\",\"author\":{\"@type\":\"Person\",\"@id\":\"https://pavansharmaportfolio.in/#person\",\"name\":\"Pavan Sharma\",\"url\":\"https://pavansharmaportfolio.in/about/\"},\"publisher\":{\"@type\":\"Person\",\"@id\":\"https://pavansharmaportfolio.in/#person\",\"name\":\"Pavan Sharma\"}}"}}],["$","article",null,{"className":"max-w-3xl mx-auto","children":[["$","header",null,{"className":"cyber-glass-strong p-5 md:p-7 mb-8","children":[["$","div",null,{"className":"flex items-center justify-between mb-3 flex-wrap gap-2","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","div",null,{"className":"w-2 h-2 rounded-full bg-cyber-green animate-pulse"}],["$","span",null,{"className":"font-code text-[10px] text-cyber-green uppercase tracking-widest","children":"Decrypted Data"}]]}],["$","div",null,{"className":"flex items-center gap-3 font-code text-xs text-cyber-blue-dim","children":[["$","time",null,{"dateTime":"2026-05-14","children":"2026-05-14"}],["$","span",null,{"children":"•"}],["$","span",null,{"children":"8 min read"}]]}]]}],["$","h1",null,{"className":"font-cyber text-xl md:text-2xl text-cyber-blue uppercase tracking-wider","children":"LLM Red Teaming: How I Built Sentinel AI to Break Large Language Models"}],["$","div",null,{"className":"flex gap-2 mt-3 flex-wrap","children":["$L18","$L19","$L1a","$L1b"]}],"$L1c"]}],"$L1d","$L1e","$L1f","$L20"]}]]]}]]}],"$L21"]}]
