1d:["$","div",null,{"className":"cyber-glass p-5 md:p-7","children":[["$","h2","h2-0",{"className":"font-cyber text-lg text-cyber-blue mb-3 mt-5 border-b border-cyan-900/20 pb-2","children":"The Problem with AI Safety Testing"}],"\n",["$","p","p-0",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"Large Language Models are deployed everywhere — customer support, coding assistants, medical information, legal research. But most of these systems are evaluated only on the happy path: does it answer correctly when given a clean, well-intentioned prompt?"}],"\n",["$","p","p-1",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":["I built ",["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Sentinel AI"}],", an LLM Red Teaming Framework, because the more important question is: what happens when someone tries to break it?"]}],"\n",["$","h2","h2-1",{"className":"font-cyber text-lg text-cyber-blue mb-3 mt-5 border-b border-cyan-900/20 pb-2","children":"What is LLM Red Teaming?"}],"\n",["$","p","p-2",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"Red teaming comes from military strategy — you put a team in the adversary's position and have them attack your own defenses. In AI safety, it means systematically probing a language model to find:"}],"\n",["$","ul","ul-0",{"className":"space-y-1 mb-4 ml-4","children":["\n",["$","li","li-0",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":[["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Jailbreaks"}],": prompts that bypass the model's safety guardrails"]}]]}],"\n",["$","li","li-1",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":[["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Prompt injections"}],": hidden instructions smuggled inside user inputs"]}]]}],"\n",["$","li","li-2",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":[["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Alignment failures"}],": cases where the model does something technically correct but ethically wrong"]}]]}],"\n",["$","li","li-3",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":[["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Hallucination patterns"}],": predictable categories of confident wrong answers"]}]]}],"\n",["$","li","li-4",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":[["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Data leakage"}],": unintended exposure of training data or system prompts"]}]]}],"\n"]}],"\n",["$","h2","h2-2",{"className":"font-cyber text-lg text-cyber-blue mb-3 mt-5 border-b border-cyan-900/20 pb-2","children":"How Sentinel AI Works"}],"\n",["$","p","p-3",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"The framework is built in Python with three core modules:"}],"\n",["$","h3","h3-0",{"className":"font-cyber text-base text-cyber-purple mb-2 mt-4","children":"1. Attack Generation Engine"}],"\n",["$","p","p-4",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"This module generates adversarial prompts using a taxonomy I built from published AI safety research. Categories include role-playing attacks (asking the model to pretend to be a different AI), indirect injection (embedding instructions in supposed \"user data\"), and suffix attacks that confuse the model's context window."}],"\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d","\n","$L2e"]}]
