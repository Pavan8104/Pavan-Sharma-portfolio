1d:["$","div",null,{"className":"cyber-glass p-5 md:p-7","children":[["$","h2","h2-0",{"className":"font-cyber text-lg text-cyber-blue mb-3 mt-5 border-b border-cyan-900/20 pb-2","children":"What the Certification Gets Right (and Wrong)"}],"\n",["$","p","p-0",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"Earning the AWS Solution Architect Associate certification gave me a solid map of the AWS ecosystem — EC2, S3, RDS, Lambda, VPC, IAM, CloudFront, Route 53, and dozens of other services. The exam tests whether you can identify the right service for a scenario."}],"\n",["$","p","p-1",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"What it doesn't teach you: how to actually make these choices under real constraints — budget, team expertise, time pressure, and the reality that \"it depends\" is the true answer to most architecture questions."}],"\n",["$","p","p-2",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"Here's what I've learned building real systems."}],"\n",["$","h2","h2-1",{"className":"font-cyber text-lg text-cyber-blue mb-3 mt-5 border-b border-cyan-900/20 pb-2","children":"The Serverless vs. Containers Decision"}],"\n",["$","p","p-3",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"AWS Lambda is genuinely great for:"}],"\n",["$","ul","ul-0",{"className":"space-y-1 mb-4 ml-4","children":["\n",["$","li","li-0",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Event-driven processing (S3 upload triggers, DynamoDB streams, API Gateway)"}]]}],"\n",["$","li","li-1",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Scheduled jobs that run infrequently"}]]}],"\n",["$","li","li-2",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Workloads with highly variable traffic"}]]}],"\n"]}],"\n",["$","p","p-4",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":"Lambda is wrong for:"}],"\n",["$","ul","ul-1",{"className":"space-y-1 mb-4 ml-4","children":["\n",["$","li","li-0",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Jobs running longer than 15 minutes"}]]}],"\n",["$","li","li-1",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"ML inference with large models (cold start + memory limits)"}]]}],"\n",["$","li","li-2",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Anything requiring persistent connections (WebSockets need ALB + ECS)"}]]}],"\n",["$","li","li-3",{"className":"font-code text-sm text-cyber-blue-dim flex items-start gap-2","children":[["$","span",null,{"className":"text-neon-pink mt-0.5","children":"▸"}],["$","span",null,{"children":"Cost at sustained high throughput (EC2 or Fargate is cheaper above ~1M requests/month)"}]]}],"\n"]}],"\n",["$","p","p-5",{"className":"font-code text-sm text-cyber-blue-dim leading-relaxed mb-4","children":["For most backend APIs, I now default to ",["$","strong","strong-0",{"className":"text-cyber-blue font-bold","children":"Fargate"}]," (serverless containers) over Lambda. It gives you more control over runtime, no cold starts on warm tasks, and the mental model is simpler."]}],"\n","$